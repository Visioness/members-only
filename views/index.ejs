<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Members Only | Messages</title>
  </head>
  <body>
    <header>
      <h1>Members Only</h1>
      <nav>
        <% if (locals.currentUser) { %>
        <a href="/log-out">Log Out</a>
        <% } else { %>
        <a href="/log-in">Log In</a>
        <a href="/sign-up">Sign Up</a>
        <% } %>
      </nav>
    </header>
    <main>
      <% if (locals.messages) { %>
      <h2>Messages</h2>
      <ul>
        <% if (messages.length > 0) { %> <% messages.forEach(message => { %>
        <li>
          <div class="message">
            <h3 class="title"><%= message.title %></h3>
            <p class="text"><%= message.text %></p>
            <% if (locals.currentUser && locals.currentUser.has_membership) { %>
            <span class="timestamp"
              ><%= message.timestamp.toLocaleDateString() %> - <%=
              message.timestamp.toLocaleTimeString() %></span
            >
            <span class="author"><%= message.author %></span>
            <% } %>
          </div>
        </li>
        <% }) %> <% } else { %>
        <p>Be first to add messages!</p>
        <% } %> <% if (locals.currentUser) { %>
        <button type="button" class="btn-new">Create New Message</button>
        <div class="new-message-container" hidden>
          <form action="/messages/new" method="POST">
            <input
              type="text"
              name="title"
              id="title"
              placeholder="Title"
              required />
            <input
              type="text"
              name="text"
              id="text"
              placeholder="Your message to world..."
              required />
            <button type="submit" class="btn-submit">Save Message</button>
            <button type="button" id="cancel-new-message" class="btn-cancel">
              Cancel
            </button>
          </form>
        </div>
        <% if (!currentUser.has_membership) { %>
        <button type="button" class="btn-secret">Unhide The Secret</button>
        <% } %> <% } %>
      </ul>
      <% } %>
      <dialog class="secret-dialog">
        <div class="secret-container">
          <form action="/secret" method="POST">
            <p>
              What would the reflection of the secret code from a mirror be?
            </p>
            <div class="input-group">
              <label for="secretCode">Secret Code: </label>
              <input
                type="text"
                name="secretCode"
                id="secretCode"
                placeholder="V3ry S3cr3t C0d3"
                required />
            </div>
            <button type="submit" class="btn-submit">Submit Secret Code</button>
          </form>
          <button id="close-dialog" class="btn-cancel">X</button>
        </div>
      </dialog>
      <% if (locals.errors) { %> <% if (errors.length > 0) { %>
      <ul class="errors">
        <% errors.forEach(error => { %>
        <li class="error"><%= error.msg %></li>
        <% }) %>
      </ul>
      <% } %> <% } %>
    </main>

    <script>
      const newMessageContainer = document.querySelector(
        '.new-message-container'
      );
      const newMessageButton = document.querySelector('.btn-new');
      const cancelButton = document.getElementById('cancel-new-message');

      const secretDialog = document.querySelector('.secret-dialog');
      const secretButton = document.querySelector('.btn-secret');
      const closeButton = document.getElementById('close-dialog');

      [newMessageButton, cancelButton].forEach((button) => {
        button.addEventListener('click', () => {
          newMessageContainer.hidden = !newMessageContainer.hidden;
        });
      });

      secretButton.addEventListener('click', () => {
        secretButton.hidden = true;
        secretDialog.showModal();
      });

      closeButton.addEventListener('click', () => {
        secretButton.hidden = false;
        secretDialog.close();
      });
    </script>
  </body>
</html>
